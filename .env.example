# Postgres
DATABASE_URL=postgresql://mauagent:mauagent@localhost:5432/mauagent

# Auth0 (v4 SDK) — create a Regular Web App; callback http://localhost:3000/auth/callback
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=            # openssl rand -hex 32
APP_BASE_URL=http://localhost:3000

# S3 (leave S3_ENDPOINT empty for real AWS; set it for local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mauagent
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Inngest (the dev server needs no key)
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# LLM (OpenRouter, OpenAI-compatible). Only these four live in env; model per agent, effort, tokens and caps are
# set in /settings/ai. AI_MODEL is the default model when the settings page leaves it empty.
AI_API_KEY=sk-or-v1-xxxxxxxx
# Optional: used when the primary key gets 401/402/429/5xx.
AI_API_KEY_FALLBACK=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional: the model that describes pictures uploaded as context for text posts (must accept images).
# AI_VISION_MODEL=google/gemma-4-31b-it:free

# Optional: image model for auto-generated character views (OpenRouter image-output model).
# IMAGE_MODEL=google/gemini-2.5-flash-image
# Magic Hour (magichour.ai) image generation. Provider order and models are chosen in /settings/ai.
MAGIC_HOUR_API_KEY=

# Apify TikTok Trends (Trend Scout). Everything else is fixed defaults; see /trends.
APIFY_API_TOKEN=
# APIFY_TIKTOK_TRENDS_ACTOR_ID=GULLsEZsAD69QFACQ

# Social accounts — OAuth tokens are encrypted at rest with this key (openssl rand -hex 32). Changing it orphans stored tokens.
TOKEN_ENC_KEY=
# Instagram API with Instagram Login — redirect URI: $APP_BASE_URL/api/oauth/instagram
IG_APP_ID=
IG_APP_SECRET=
IG_GRAPH_VERSION=v25.0
# TikTok Login Kit (web) — redirect URI: $APP_BASE_URL/api/oauth/tiktok (TikTok requires https, use a tunnel locally)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# BytePlus ModelArk (Seedance) — get model IDs from the ModelArk console
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL_DRAFT=
SEEDANCE_RES_DRAFT=720p
SEEDANCE_MODEL_FINAL=
SEEDANCE_RES_FINAL=1080p

# Buffer — publishes to the Instagram, TikTok and Threads channels connected in Buffer (publish.buffer.com/settings/api)
BUFFER_API_KEY=
# Optional: organization (default: the key's first), API URL, parallel requests.
BUFFER_ORGANIZATION_ID=
BUFFER_API_URL=https://api.buffer.com
BUFFER_MAX_CONCURRENCY=2

# Automation campaigns: the highest target post count a campaign may have.
AUTOMATION_MAX_POSTS=2000

# Cloudinary (library reference images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Trigger.dev (workflow orchestration; WORKFLOW_ENGINE stays "inngest" until parity is proven)
WORKFLOW_ENGINE=inngest
TRIGGER_PROJECT_REF=proj_yprvcvooehbxmyjxugzs
TRIGGER_SECRET_KEY=
# Per-provider concurrency limits (defaults in src/trigger/queues.ts)
# TRIGGER_CONCURRENCY_VIDEO=2
# TRIGGER_CONCURRENCY_ELEVENLABS=2
# TRIGGER_CONCURRENCY_VIDIQ=1
# TRIGGER_CONCURRENCY_GEMINI_LLM=5
# TRIGGER_CONCURRENCY_FFMPEG_RENDER=1
