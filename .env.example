# Postgres
DATABASE_URL=postgresql://mauagent:mauagent@localhost:5432/mauagent

# Auth0 (v4 SDK) — create a Regular Web App; callback http://localhost:3000/auth/callback
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=            # openssl rand -hex 32
APP_BASE_URL=http://localhost:3000

# S3 (leave S3_ENDPOINT empty for real AWS; set it for local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mauagent
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Inngest (the dev server needs no key)
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# LLM (Gemini) — model per agent, AGENT_MODEL_<ROLE> overrides the default
GOOGLE_GENERATIVE_AI_API_KEY=
AGENT_MODEL_DEFAULT=gemini-2.5-flash
# AGENT_MODEL_CREATIVEDIRECTOR=gemini-2.5-pro

# BytePlus ModelArk (Seedance) — get model IDs from the ModelArk console
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL_DRAFT=
SEEDANCE_RES_DRAFT=720p
SEEDANCE_MODEL_FINAL=
SEEDANCE_RES_FINAL=1080p
