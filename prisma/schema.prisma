generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFTING
  AWAITING_BUDGET
  AWAITING_VIDEO_UPLOAD
  POST_PRODUCTION
  AWAITING_APPROVAL
  REVISING
  REGENERATING
  APPROVED
  PUBLISHING
  PUBLISHED
  REJECTED
  EXPIRED
  FAILED
}

enum VideoSource {
  seedance_api
  manual_upload
}

enum AssetOrigin {
  seedance
  upload
}

enum DecisionType {
  approve
  revise
  regenerate
  reject
}

enum CostReason {
  initial
  revision
  regenerate
  trend
  test
}

enum ReasoningEffort {
  off
  low
  medium
  high
}

model BrandKit {
  id         String          @id @default(cuid())
  name       String
  logoUrl    String?
  palette    Json?
  fonts      Json?
  voiceId    String?
  styleNotes String?
  campaigns  Campaign[]
  accounts   SocialAccount[]
}

// Singleton (id = "default"): budget caps configurable from the Settings page.
model Setting {
  id                 String      @id @default("default")
  campaignBudgetUsd  Decimal     @default(20) @db.Decimal(10, 2)
  monthlyBudgetUsd   Decimal     @default(300) @db.Decimal(10, 2)
  defaultVideoSource VideoSource @default(manual_upload)
  // Agent memory: off = agents run without recall and no episodes are written.
  memoryEnabled      Boolean     @default(true)
  memoryTokenBudget  Int         @default(800)
  // Owner's time zone: Boards agenda days and dates.
  timezone           String      @default("Asia/Jakarta")
  // Style guide distilled from the owner's own tweets (editable). Read by the Socmed Specialist when writing posts.
  writingVoice       String?
}

// Cached result of the free health checks (integrations-health job). Boards reads this, never the provider.
model IntegrationStatus {
  id        String   @id // registry id in src/lib/integrations.ts
  ok        Boolean
  summary   String?
  checkedAt DateTime @default(now())
}

model Campaign {
  id              String          @id @default(cuid())
  brandKitId      String?
  brandKit        BrandKit?       @relation(fields: [brandKitId], references: [id])
  clientBrief     Json
  status          CampaignStatus  @default(DRAFTING)
  budgetCapUsd    Decimal         @db.Decimal(10, 2)
  defaultSource   VideoSource
  finalCutKey     String?
  // Latest Account Team QC output (history lives in Artifact "accountTeam").
  approvalPackage Json?
  createdAt       DateTime        @default(now())
  runs            Run[]
  artifacts       Artifact[]
  shots           Shot[]
  decisions       Decision[]
  costs           CostEntry[]
  publishJobs     PublishJob[]
  creativeAssets  CreativeAsset[]
  messages        AgentMessage[]

  @@index([status])
}

enum CreativeKind {
  character
  location
  style
}

// Reusable building block from the AI Content Creator library: a character, a location or a video style
// (8-bit, 2D animation, …). Linked to many campaigns; the Art Director reads the linked set on every run.
model CreativeAsset {
  id          String       @id @default(cuid())
  kind        CreativeKind
  name        String
  description String
  imageUrls   String[]
  // Talent locked by the owner = ready for the Content Creator.
  lockedAt    DateTime?
  campaigns   Campaign[]
  createdAt   DateTime     @default(now())
}

model Run {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id])
  inngestRunId String?
  status       String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  steps        Step[]

  @@index([campaignId, status])
}

// Transcript of a pipeline run: what each agent said and handed to the next one (shown live on the campaign page).
model AgentMessage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  runId      String
  agentRole  String
  toRole     String?
  kind       String // start | output | handoff | error
  content    String
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
}

model Step {
  id        String    @id @default(cuid())
  runId     String
  run       Run       @relation(fields: [runId], references: [id])
  agentRole String
  status    String
  attempt   Int       @default(1)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  error     String?

  @@index([runId])
  @@index([agentRole, status])
}

model Artifact {
  id          String    @id @default(cuid())
  // Null for the output of a direct task (Boards workspace) that has not been sent to a campaign.
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  // Direct task that produced it (or, on a campaign copy, the task it was seeded from).
  agentTaskId String?
  agentRole   String
  version     Int
  payload     Json
  costUsd     Decimal   @default(0) @db.Decimal(10, 4)
  runId       String?
  createdAt   DateTime  @default(now())

  @@unique([campaignId, agentRole, version])
  @@index([agentRole, createdAt])
  @@index([agentTaskId])
}

model Shot {
  id            String      @id @default(cuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id])
  shotId        String
  source        VideoSource
  maxAttempts   Int         @default(3)
  status        String      @default("pending")
  promptPackage Json?
  assets        ShotAsset[]

  @@unique([campaignId, shotId])
}

model ShotAsset {
  id          String      @id @default(cuid())
  shotId      String
  shot        Shot        @relation(fields: [shotId], references: [id])
  version     Int
  s3Key       String
  durationSec Float?
  hasAudio    Boolean?
  validation  Json?
  origin      AssetOrigin
  createdAt   DateTime    @default(now())

  @@unique([shotId, version])
}

model Decision {
  id          String       @id @default(cuid())
  campaignId  String
  campaign    Campaign     @relation(fields: [campaignId], references: [id])
  type        DecisionType
  notes       String?
  targetAgent String?
  shotIds     String[]
  createdAt   DateTime     @default(now())
}

// The single cost ledger: every paid (or quota-limited) call writes one row. Caps and reports sum this table.
model CostEntry {
  id              String     @id @default(cuid())
  // Null for calls outside a campaign (direct tasks, trend runs, connection tests).
  campaignId      String?
  campaign        Campaign?  @relation(fields: [campaignId], references: [id])
  step            String
  provider        String
  model           String
  agentRole       String?
  units           Decimal    @db.Decimal(12, 4)
  unitPrice       Decimal    @db.Decimal(12, 6)
  usd             Decimal    @db.Decimal(10, 4)
  tokensIn        Int?
  tokensOut       Int?
  tokensReasoning Int?
  // primary | fallback (which AI key served the call; never the key itself).
  keyLabel        String?
  // Validated LLM result: a retried step with the same idemKey prefix reuses it instead of calling again.
  output          Json?
  attempt         Int        @default(1)
  reason          CostReason @default(initial)
  // campaignId:step:attempt — prevents double charges on retry.
  idemKey         String     @unique
  createdAt       DateTime   @default(now())

  @@index([provider, createdAt])
}

// Singleton (id = "default"): LLM settings from /settings/ai. Keys stay in env; empty defaultModel = env AI_MODEL.
model AiSettings {
  id                String          @id @default("default")
  brandKitId        String?
  defaultModel      String?
  reasoningEffort   ReasoningEffort @default(low)
  maxOutputTokens   Int             @default(4096)
  temperature       Float           @default(0.7)
  // { [role]: { model?, reasoningEffort?, maxOutputTokens? } }, validated by AiOverrides (src/lib/ai/settings.ts).
  perAgentOverrides Json            @default("{\"creativeDirector\":{\"reasoningEffort\":\"medium\"},\"accountTeam\":{\"reasoningEffort\":\"low\"},\"router\":{\"reasoningEffort\":\"off\"}}")
  // LLM-only caps (provider openrouter), enforced in generateStructured.
  monthlyBudgetUsd  Decimal         @default(40) @db.Decimal(10, 2)
  maxCostPerCallUsd Decimal         @default(0.5) @db.Decimal(10, 4)
  monthlyTokenCap   Int             @default(5000000)
  enableFallbackKey Boolean         @default(true)
  // Image generation: ordered provider list (first = preferred, rest = fallback) and optional model per provider.
  imageProviders    String          @default("magichour,modelark,openrouter")
  imageModels       Json            @default("{}")
  // Video generation, same shape. Providers: byteplus (Seedance), magichour.
  videoProviders    String          @default("byteplus,magichour")
  videoModels       Json            @default("{}")
}

// Apify TikTok Trends settings, one row per source and brand (null = global). Token stays in env.
model TrendSourceSettings {
  id               String   @id @default(cuid())
  source           String   @default("apify_tiktok")
  brandKitId       String?
  trendType        String   @default("hashtags")
  maxItems         Int      @default(20)
  countryCode      String
  hashtagPeriod    String   @default("7")
  industryId       String   @default("")
  videoCountry     String
  videoPeriod      String   @default("7")
  videoContentTag  String   @default("")
  videoOrderBy     String   @default("1")
  videoOrganicOnly Boolean  @default(false)
  saveMedia        Boolean  @default(false)
  useApifyProxy    Boolean  @default(true)
  scheduleCron     String   @default("0 6 * * *")
  enabled          Boolean  @default(false)
  // A successful run younger than this is reused instead of calling the actor (cron only).
  cacheHours       Int      @default(20)
  monthlyRunCap    Int      @default(150)
  maxCostPerRunUsd Decimal  @default(0.5) @db.Decimal(10, 4)
  updatedAt        DateTime @updatedAt

  @@unique([source, brandKitId])
}

// One actor run. idemKey = trend:<eventId>, so an Inngest retry resumes the same Apify run.
model TrendRun {
  id         String    @id @default(cuid())
  source     String    @default("apify_tiktok")
  idemKey    String    @unique
  trigger    String
  apifyRunId String?
  status     String    @default("pending")
  itemCount  Int?
  durationMs Int?
  usd        Decimal?  @db.Decimal(10, 4)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([source, status, startedAt])
}

// F12: one trend per source per day (dedupe on externalId + capturedDay).
model TrendSignal {
  id           String   @id @default(cuid())
  source       String
  platform     Platform
  trendType    String
  externalId   String
  url          String
  outlierScore Float
  hook         String
  format       String
  audio        String?
  capturedAt   DateTime @default(now())
  capturedDay  DateTime @db.Date
  rawPayload   Json

  @@unique([source, externalId, capturedDay])
  @@index([capturedAt, outlierScore])
}

// Versioned agent persona. The latest version per role is active; a restore copies an old version as a new one.
model AgentProfile {
  id        String   @id @default(cuid())
  role      String
  version   Int
  persona   Json
  note      String?
  createdAt DateTime @default(now())

  @@unique([role, version])
}

enum MemoryLayer {
  episodic
  lesson
  procedural
}

// One memory item of one agent role. Every write goes through writeMemory() (secret/PII redaction).
model AgentMemory {
  id                String      @id @default(cuid())
  role              String
  layer             MemoryLayer
  content           String
  tags              String[]
  campaignId        String?
  sourceArtifactIds String[]
  // Evidence (used by lessons/procedural from Stage 3): distinct campaigns that support it.
  campaignIds       String[]
  confidence        Float       @default(0)
  pinned            Boolean     @default(false)
  archivedAt        DateTime?
  // episode:campaignId:role — one episode per role per campaign.
  idemKey           String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([role, layer])
}

// Which memories an agent saw on a pipeline run (audit + impact evaluation).
model AgentMemoryUse {
  id         String   @id @default(cuid())
  runId      String
  campaignId String
  role       String
  memoryIds  String[]
  createdAt  DateTime @default(now())

  @@unique([runId, role])
}

enum Platform {
  instagram
  tiktok
  threads
  twitter
}

enum PublisherKind {
  instagram_graph
  tiktok_inbox
  orshot
  buffer
}

enum AccountStatus {
  connected
  needs_reauth
  disabled
  missing
}

// How a job is handed to Buffer: next queue slot, exact time, draft (never posts), or immediately.
enum PublishMode {
  queue
  scheduled
  draft
  now
}

enum PublishStatus {
  draft
  scheduled
  publishing
  published
  failed
}

// Connected social account (many per platform and per brand). Tokens are AES-GCM encrypted (src/lib/crypto.ts)
// and never selected for the client: pages use ACCOUNT_PUBLIC_SELECT (src/lib/accounts.ts).
model SocialAccount {
  id                   String        @id @default(cuid())
  platform             Platform
  platformUserId       String
  handle               String
  accountType          String?
  brandKitId           String?
  brandKit             BrandKit?     @relation(fields: [brandKitId], references: [id])
  timezone             String        @default("Asia/Jakarta")
  accessTokenEnc       String
  refreshTokenEnc      String?
  tokenExpiresAt       DateTime?
  refreshExpiresAt     DateTime?
  scopes               String[]
  // Entered by hand: not_submitted | pending | approved | rejected (TikTok only).
  tiktokAuditStatus    String?
  publisher            PublisherKind
  // For Buffer channels `active` is "enabled for publishing"; status mirrors the channel's state in Buffer.
  active               Boolean       @default(true)
  status               AccountStatus @default(connected)
  isDefaultForPlatform Boolean       @default(false)
  lastSyncedAt         DateTime?
  avatarUrl            String?
  lastError            String?
  quotaUsage           Int?
  quotaTotal           Int?
  quotaCheckedAt       DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  publishJobs          PublishJob[]

  @@unique([platform, platformUserId])
}

// One job per campaign per target account. Posting itself arrives with the Officer workspace (Stage 5).
model PublishJob {
  id               String           @id @default(cuid())
  // Null for a text post from a Socmed Specialist task: those have no campaign and no video.
  campaignId       String?
  campaign         Campaign?        @relation(fields: [campaignId], references: [id])
  // The generation task this post came from (text posts only).
  agentTaskId      String?
  agentTask        AgentTask?       @relation(fields: [agentTaskId], references: [id])
  socialAccountId  String
  socialAccount    SocialAccount    @relation(fields: [socialAccountId], references: [id])
  platform         Platform
  status           PublishStatus    @default(draft)
  caption          String?
  hashtags         String[]
  // Thread parts AFTER `caption` (which is part 1). Empty = a single post.
  thread           String[]         @default([])
  scheduledAt      DateTime?
  postId           String?
  permalink        String?
  error            String?
  mode             PublishMode      @default(now)
  attempt          Int              @default(1)
  lastPolledAt     DateTime?
  // Text posts that state a fact: the source the AI named and how sure it said it was (high|medium|low).
  // Shown on the draft so the owner can check it before the post is scheduled.
  sourceNote       String?
  sourceConfidence String?
  metricSnapshots  MetricSnapshot[]
  // campaignId:socialAccountId:attempt (campaign video) | task:agentTaskId:slot:socialAccountId (text post).
  // A retry makes a new attempt only when the last one never got a postId.
  idemKey          String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([socialAccountId, status])
  @@index([agentTaskId])
}

// Post metrics pulled from Buffer at T+1h, T+24h and T+7d after the post is sent. Only what Buffer returns is stored.
model MetricSnapshot {
  id           String     @id @default(cuid())
  publishJobId String
  publishJob   PublishJob @relation(fields: [publishJobId], references: [id])
  window       String // 1h | 24h | 7d
  source       String     @default("buffer")
  capturedAt   DateTime   @default(now())
  metrics      Json // { items: [{ type, name, value, unit }], metricsUpdatedAt?, reason? }

  @@unique([publishJobId, window])
}

model PriceBook {
  id            String   @id @default(cuid())
  provider      String
  model         String
  unit          String
  unitPrice     Decimal  @db.Decimal(12, 6)
  effectiveFrom DateTime @default(now())

  @@unique([provider, model, unit, effectiveFrom])
}

enum TaskStatus {
  QUEUED
  RUNNING
  WAITING
  DONE
  FAILED
}

// A direct task from a Boards workspace: one agent runs alone, outside the campaign pipeline.
model AgentTask {
  id               String       @id @default(cuid())
  agentRole        String
  input            Json
  status           TaskStatus   @default(QUEUED)
  // Retry = attempt + 1; the Inngest event id is taskId:attempt.
  attempt          Int          @default(1)
  artifactId       String?      @unique
  // Campaign created by "Send to flow".
  campaignId       String?
  // Hand-off between agents (e.g. Content Creator asks the Talent Manager).
  requestedByRole  String?
  // Chain that runs automatically on this task's output: a key of CHAINS in src/lib/boards/flows.ts
  // (Concept: "creativeDirector"; Production pack: "production-pack").
  thenRole         String?
  estUsd           Decimal      @default(0) @db.Decimal(10, 4)
  costUsd          Decimal      @default(0) @db.Decimal(10, 4)
  confirmedOverCap Boolean      @default(false)
  error            String?
  // Live Socmed Specialist / QC conversation while a text batch runs (Note[]); the finished one lives in the artifact.
  progress         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  // Text posts scheduled from this task's output (Socmed Specialist).
  publishJobs      PublishJob[]

  @@index([agentRole, status])
}

enum FeedbackSource {
  client_decision
  qc
  metrics
  owner_note
}

enum Sentiment {
  positive
  neutral
  negative
}

// Feedback aimed at one agent role: automatic (client decisions, QC) or written by the owner. Also episodic memory.
model AgentFeedback {
  id          String         @id @default(cuid())
  agentRole   String
  campaignId  String?
  agentTaskId String?
  source      FeedbackSource
  sentiment   Sentiment
  text        String
  // decision:<id> / qc:<artifactId> — automatic feedback is written once per source event.
  idemKey     String?        @unique
  createdAt   DateTime       @default(now())

  @@index([agentRole, createdAt])
  @@index([campaignId])
}

enum ContentFileKind {
  text
  image
}

// Context the owner uploads for text posts (src/lib/content): notes and documents as text, pictures as an AI
// description. The posts read it as background data; nothing in it is published as is.
model ContentFile {
  id        String          @id @default(cuid())
  name      String
  mime      String
  kind      ContentFileKind
  sizeBytes Int
  // Text files: the extracted text (capped). Images: what the AI saw in the picture.
  content   String
  createdAt DateTime        @default(now())
}
